{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiliang.local/mission-repair.schema.json",
  "title": "In-flight mission audit repair",
  "type": "object",
  "required": ["schema_version", "run_id", "repair_cycles", "source_audit_sequence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "repair_cycles": { "type": "integer", "minimum": 1, "maximum": 2 },
    "source_audit_sequence": { "type": "integer", "minimum": 1 }
  }
}
