{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiliang.local/mission-plan.schema.json",
  "title": "Mission plan",
  "description": "Frozen mission DAG consumed by the canonical mission executor.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "goal",
    "repo",
    "mode",
    "branch",
    "boundaries",
    "acceptance_criteria",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "goal": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["attended", "unattended"] },
    "branch": { "type": "string", "pattern": "^agent/(mission|loop)-" },
    "governance": {
      "type": "object",
      "required": ["runtime_version", "constitution_sha256", "contract_sha256", "executor_sha256"],
      "additionalProperties": false,
      "properties": {
        "runtime_version": { "type": "string", "minLength": 1 },
        "constitution_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "executor_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "description": "The deployed runtime and governing inputs loaded before the plan froze. Optional only so already-frozen 1.0 plans remain resumable."
    },
    "boundaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "title",
        "instruction",
        "deps",
        "parallelizable",
        "write_set",
        "acceptance_criteria",
        "witness"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "deps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parallelizable": { "type": "boolean" },
        "write_set": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths this node may modify. Empty means read-only."
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "witness": {
          "type": "object",
          "required": ["claim", "kind", "method"],
          "additionalProperties": false,
          "properties": {
            "claim": { "type": "string", "minLength": 1 },
            "kind": {
              "enum": ["machine", "measured", "reviewed", "human-deferred"],
              "description": "machine: a deterministic check observes the claim; measured: instrumentation observes it; reviewed: a fresh artifact-only critic must independently close the judgment-bearing claim; human-deferred: only the human can close it."
            },
            "method": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
